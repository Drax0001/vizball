PORT=5000
HOST=127.0.0.1
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
# Dev: relative path below is fine. Production: use a distinct ABSOLUTE path
# (see DEPLOYMENT.md) so the prod database file is never the same file as dev.
DB_PATH=./vizball.db
UPLOAD_DIR=./uploads
# Free Groq API key for the manual article/forum/event translation feature —
# create one at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile




